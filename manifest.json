{
  "manifest_version": 3,
  "name": "arXiv Reference Remover",
  "version": "1.0.0",
  "description": "Remove inline citations and the bibliography from arXiv HTML pages with one click.",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    },
    "default_title": "Remove references from this page"
  }
}
